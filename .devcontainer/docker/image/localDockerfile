FROM golang:1.24-alpine AS local

RUN apk add --no-cache \
    git \
    make \
    curl \
    bash \
    gcc \
    musl-dev\
    ca-certificates\
    openssl\
    openssh-client\
    tar\
    wget\
    nano

RUN echo "127.0.0.1 $VHOST" >> /etc/hosts

WORKDIR $WORKDIR

EXPOSE $VHOST_PORT

CMD tail -f /dev/null
